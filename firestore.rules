rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Everyone can read all submissions; each visitor (anonymous sign-in) can only write their own.
    match /submissions/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'order', 'champs', 'picks', 'champion', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.order is list
        && request.resource.data.order.size() == 25;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
